{
  "name": "papercade",
  "version": "0.1.0",
  "description": "A pixel × hand-drawn design library. NES.css × Excalidraw, with a character in it.",
  "style": "dist/papercade.css",
  "exports": {
    ".": "./dist/papercade.css",
    "./papercade.css": "./dist/papercade.css",
    "./tokens.css": "./dist/tokens.css",
    "./fonts/*": "./dist/fonts/*"
  },
  "type": "module",
  "license": "MIT",
  "author": "Parth Anand (https://parthanand.in)",
  "homepage": "https://anandparth.github.io/papercade/",
  "repository": {
    "type": "git",
    "url": "https://github.com/anandparth/papercade.git"
  },
  "keywords": ["design-system", "css", "pixel-art", "8-bit", "hand-drawn", "sketch", "excalidraw", "retro", "design-tokens"],
  "files": ["dist", "LICENSE", "LICENSE-GRAPHICS"],
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build && vite site --open",
    "preview": "npm run build && vite site"
  },
  "devDependencies": {
    "@types/node": "^24",
    "style-dictionary": "^5.1.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.4"
  }
}
